{
  "appId": "com.patpat.game",
  "appName": "PATPAT",
  "webDir": "dist",
  "backgroundColor": "#bfe3ff",
  "zoomEnabled": false,
  "loggingBehavior": "debug",
  "android": {
    "backgroundColor": "#bfe3ff",
    "allowMixedContent": false,
    "zoomEnabled": false,
    "loggingBehavior": "debug"
  },
  "ios": {
    "backgroundColor": "#bfe3ff",
    "contentInset": "never",
    "scrollEnabled": false,
    "allowsLinkPreview": false,
    "zoomEnabled": false,
    "preferredContentMode": "mobile",
    "loggingBehavior": "debug"
  },
  "plugins": {
    "SystemBars": {
      "hidden": true,
      "style": "LIGHT",
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "animation": "NONE"
    }
  }
}
